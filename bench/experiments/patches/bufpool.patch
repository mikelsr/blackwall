+
+// copyBuffers holds the 32 KiB buffers httputil.ReverseProxy copies response
+// bodies through. Without a BufferPool it allocates one per response.
+var copyBuffers = sync.Pool{New: func() any { b := make([]byte, 32*1024); return &b }}
+
+type copyBufferPool struct{}
+
+func (copyBufferPool) Get() []byte  { return *copyBuffers.Get().(*[]byte) }
+func (copyBufferPool) Put(b []byte) { copyBuffers.Put(&b) }
 
